# ---------- Python / Backend ----------
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
*.egg-info/
*.egg
*.whl
pip-log.txt
pip-delete-this-directory.txt

# ---------- Database ----------
*.db
*.sqlite3
easy_rescue.db

# ---------- Node / Frontend ----------
node_modules/
dist/
build/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Environment & Secrets ----------
# NEVER commit secrets, API keys, tokens, or credentials
.env
.env.*
.env.local
.env.development
.env.production
.env.staging
*.pem
*.key
*.cert
*.secret

# ---------- Docker ----------
docker-compose.override.yml

# ---------- OS / Editor ----------
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- Logs ----------
*.log
logs/
